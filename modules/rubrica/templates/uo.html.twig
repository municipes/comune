{% macro uo(item) %}
	{% import "@rubrica/contatti.html.twig" as contattiFields %}
	<h2 class="h3 fw-bold text-primary mb-2">
		{{ item.nome }}</h2>
	{% if item.indirizzo %}
		<p class="mb-2"><strong>Indirizzo:</strong> {{ item.indirizzo }}</p>
	{% endif %}
	{{ contattiFields.group(item.contatti) }}
	{% if item.responsabile %}
		<div class="h5 mb-1">
			<em>Responsabile:</em>
			{{ item.responsabile.nome }}
		</div>
		{% if item.responsabile.desc %}
			<p class="fs-6 fw-lighter mb-1">{{ item.responsabile.desc }}</p>
		{% endif %}
		{{ contattiFields.group(item.responsabile.contatti) }}
	{% endif %}
	{% if item.persone %}
		{% import "@rubrica/persona.html.twig" as personaFields %}
		<ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3">
		{% for persona in item.persone %}
			<li class="col">
				<div class="card h-100 p-3 border rounded-3 shadow-sm">
					{{ personaFields.persona(persona, 'h6') }}
				</div>
			</li>
		{% endfor %}
		</ul>
	{% endif %}
	{% if item.figli %}
		<div class="mt-3">
			<span class="fw-semibold text-uppercase small text-secondary d-block mb-1">Uffici collegati</span>
			{% for figlio in item.figli %}
				{% include '@bi-bcl/accordion/accordion-item.html.twig' with {
					item_title: figlio.nome,
					item_body: _self.uo(figlio),
					title_id: 'uo-figlio-' ~ figlio.id,
				} only %}
			{% endfor %}
		</div>
	{% endif %}
{% endmacro %}
