{% macro persona(item, size = 'h5') %}
	{% import "@rubrica/contatti.html.twig" as contattiFields %}
	<h2 class="{{ size }} fw-bold mb-1">
		{{ item.nome }}</h2>
	{% if item.desc %}<p class="mb-2">{{ item.desc }}</p>{% endif %}
	{{ contattiFields.group(item.contatti) }}
	{% if item.uo %}
		<h4 class="h6">Unità organizzative</h4>
		{% for uo in item.uo %}
			<em>{{ uo.name }}</em><br>
			{{ uo.indirizzo }}
		{% endfor %}
	{% endif %}

{% endmacro %}
